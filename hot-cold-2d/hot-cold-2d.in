# Atomify commands start with #/

# Move camera to a nice position
#/camera position 32 11 85
#/camera target 32 11 0

# Atom colours: type 1 = the half that starts hot (red), type 2 = cold (blue)
#/atom 1 1.0 #e04b3a
#/atom 2 1.0 #3a7fe0

# --- Settings ------------------------------------------------------------
variable Thot  equal 0.8     # temperature of the left half before contact
variable Tcold equal 0.2     # temperature of the right half before contact
variable rho   equal 1.0     # reduced density: a 2D crystal
# ------------------------------------------------------------------------

units lj
boundary p p p
atom_style atomic

# A 2D hexagonal crystal, 60 x 12 unit cells (1440 atoms)
dimension 2
lattice hex ${rho}
region simbox block 0 60 0 12 -0.1 0.1
create_box 2 simbox
create_atoms 1 box

# Split the crystal into a left and a right half (fixed groups of atoms)
region lefthalf block INF 30 INF INF INF INF
group left region lefthalf
group right subtract all left
set group right type 2

# Define properties of the atoms: identical atoms, two colours
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0 2.5
velocity left  create ${Thot}  12345
velocity right create ${Tcold} 54321

# Speed up simulation with neighbour lists
neighbor 0.3 bin
neigh_modify every 20 delay 0 check yes

# A thermometer in each half
compute Tl left temp
compute Tr right temp

# Define trajectory file name and content...
dump 1 all custom 100 dump.lammpstrj id type x y vx vy

# Define thermodynamic data file (log.lammps)
thermo_style custom time temp c_Tl c_Tr pe ke etotal
thermo 50
timestep 0.005

# 1. Prepare: a heat bath on each half holds it at its own temperature
fix hot  left  nvt temp ${Thot}  ${Thot}  0.2
fix cold right nvt temp ${Tcold} ${Tcold} 0.2
run 4000

# 2. Contact: remove both heat baths. Newton's equations only from here on;
#    the total energy is conserved and heat flows from hot to cold.
unfix hot
unfix cold
fix 1 all nve
run 20000
