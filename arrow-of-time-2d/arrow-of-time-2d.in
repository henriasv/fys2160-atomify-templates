# The arrow of time: a gas starts in the left half of the box, spreads out,
# and after trev steps every velocity is reversed. Does it come back?
# Lecture 5, part 2b (Compendium 2.2). Run with different trev, e.g.
#   -var trev 2000   (comes straight back)   ...   -var trev 40000 (does not)

#/camera position 30 15 90
#/camera target 30 15 0
#/atom 1 1.0 #4c9be8

units lj
dimension 2
boundary p p p
atom_style atomic

# --- knobs -------------------------------------------------------------
variable trev  index 4000     # steps before the velocities are reversed
variable T     equal 1.0      # initial temperature (a gas)

# --- box: 28 x 8 hexagonal cells (about 60 x 30 sigma), atoms only in the
#     left half. The box is given in lattice units so that the periodic
#     images of the lattice fit exactly (a box of 30 sigma would put the top
#     row 0.2 sigma from the bottom one and blow up at step 0).
lattice hex 0.25
region simbox block 0 28 0 8 -0.1 0.1
create_box 1 simbox
region left block 0 14 0 8 -0.1 0.1
create_atoms 1 region left
mass 1 1.0
velocity all create ${T} 4928459 loop geom

pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
neighbor 0.3 bin
neigh_modify every 10 delay 0 check yes

# --- what we measure: the number of atoms in the left half --------------
variable nleft equal count(all,left)
thermo_style custom step time temp pe ke v_nleft
thermo 100
dump 1 all custom 100 dump.lammpstrj id type x y vx vy
timestep 0.005
fix 1 all nve

# --- forward ------------------------------------------------------------
run ${trev}

# --- reverse every velocity, then run the same number of steps and 4000
#     more, so that the return (or its absence) and what follows it are seen
variable nvx atom -vx
variable nvy atom -vy
set group all vx v_nvx vy v_nvy
variable tafter equal ${trev}+4000
run ${tafter}
