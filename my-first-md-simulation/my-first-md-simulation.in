# Atomify commands start with #/

# Move camera to a nice position
#/camera position 16 16 45
#/camera target 16 16 0

# Set atom size and color
#/atom 1 1.0 #ffffff

# --- Settings: the one line to change -----------------------------------
# Reduced temperature T* = kT/epsilon.  Exercise set 36: try 0.3, 0.45, 0.6
variable T equal 0.6
# ------------------------------------------------------------------------

units lj
boundary p p p
atom_style atomic

# Define the space and put atoms in: a hexagonal lattice with reduced
# density rho* = 0.65 (the red line in the phase diagram of the exercise)
dimension 2
lattice hex 0.65
region simbox block 0 24 0 14 -0.1 0.1
create_box 1 simbox
create_atoms 1 box

# Define properties of the atoms
mass 1 1.0
velocity all create ${T} 87287
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5

# Speed up simulation with neighbour lists
neighbor 0.3 bin
neigh_modify every 20 delay 0 check yes

# Define thermodynamic ensemble: a heat bath holding the temperature at T.
# Swap the two lines to run at constant energy (Newton only) instead.
fix 1 all nvt temp ${T} ${T} 0.5
#fix 1 all nve

# Mean-square displacement of the atoms; c_msd[4] is the total MSD
compute msd all msd com yes

# Define trajectory file name and content...
dump 1 all custom 50 dump.lammpstrj id type x y vx vy

# Define thermodynamic data file (log.lammps)
thermo_style custom time temp pe ke press c_msd[4]
thermo 100

# run simulation + number of steps
timestep 0.005
run 15000
