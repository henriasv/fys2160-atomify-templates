# A box of gas heated and cooled at constant pressure (2D Lennard-Jones)
# Lecture 5, part 1: watch only the box first (V grows with T), then the atoms.

#/camera position 45 45 160
#/camera target 45 45 0
#/atom 1 1.0 #4c9be8

units lj
dimension 2
boundary p p p
atom_style atomic

# --- knobs -------------------------------------------------------------
variable P    equal 0.02      # reduced pressure: a dilute gas
variable Tlo  equal 0.6       # start and end temperature (above the 2D critical point)
variable Thi  equal 3.0       # peak temperature: the box area grows by Thi/Tlo
variable ramp equal 40000     # steps for each of the two ramps

# --- box and atoms: a sparse square lattice, 400 atoms ------------------
lattice sq 0.05
region simbox block 0 20 0 20 -0.1 0.1
create_box 1 simbox
create_atoms 1 box
mass 1 1.0
velocity all create ${Tlo} 87287

pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
neighbor 0.3 bin
neigh_modify every 20 delay 0 check yes

# --- output: thermodynamics and trajectory every 200 steps ----------------
thermo_style custom step time temp press vol pe ke
thermo 200
dump 1 all custom 200 dump.lammpstrj id type x y vx vy
timestep 0.005

# --- let the box find its size at Tlo, then heat, then cool again --------
fix 1 all npt temp ${Tlo} ${Tlo} 1.0 x ${P} ${P} 5.0 y ${P} ${P} 5.0 couple xy
run 10000
unfix 1
fix 1 all npt temp ${Tlo} ${Thi} 1.0 x ${P} ${P} 5.0 y ${P} ${P} 5.0 couple xy
run ${ramp}
unfix 1
fix 1 all npt temp ${Thi} ${Tlo} 1.0 x ${P} ${P} 5.0 y ${P} ${P} 5.0 couple xy
run ${ramp}
